SHOPAGENT_ENV=development
SHOPAGENT_HOST=0.0.0.0
SHOPAGENT_PORT=8080
SHOPAGENT_LOG_LEVEL=INFO
SHOPAGENT_MEMORY_BACKEND=memory
SHOPAGENT_OPERATIONS_BACKEND=memory
SHOPAGENT_SESSION_TTL_SECONDS=1800
SHOPAGENT_LOW_CONFIDENCE_THRESHOLD=0.80
SHOPAGENT_CORS_ORIGINS=http://localhost:8080
SHOPAGENT_ADMIN_TOKEN=replace-with-a-strong-secret
SHOPAGENT_SERVICE_TOKEN=replace-with-an-independent-service-secret
SHOPAGENT_USER_TOKEN_SECRET=replace-with-an-independent-user-token-secret
SHOPAGENT_AGENT_TRANSPORT=local
SHOPAGENT_TOOL_TRANSPORT=local
SHOPAGENT_A2A_BASE_URL=http://127.0.0.1:8080/a2a
SHOPAGENT_MCP_URL=http://127.0.0.1:8080/mcp
SHOPAGENT_PUBLIC_BASE_URL=
SHOPAGENT_A2A_TASK_TTL_SECONDS=3600
SHOPAGENT_REDIS_URL=redis://localhost:6379/0
SHOPAGENT_REDIS_KEY_PREFIX=shopagent
SHOPAGENT_DATABASE_URL=mysql+pymysql://shopagent:shopagent@localhost:3306/shopagent
SHOPAGENT_LLM_BACKEND=rule
SHOPAGENT_RAG_BACKEND=character
SHOPAGENT_GUARDRAILS_ENABLED=false
SHOPAGENT_REDACT_GENERATED_ANSWERS=false
